<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.vcpf.jee202405110414.dao.UserDao">
    <insert id="insertUser" parameterType="com.vcpf.jee202405110414.entity.User">
        insert into tb_user(id,username,realname,password,gender)
        values(#{id},#{username},#{realname},#{password},#{gender})
    </insert>
    <insert id="insertObj" parameterType="com.vcpf.jee202405110414.entity.User">
        insert into tb_user(id,username,realname,password,gender)
        values(#{id},#{username},#{realname},#{password},#{gender})
    </insert>
    <select id="selectObjById" parameterType="String" resultType="com.vcpf.jee202405110414.entity.User">
        select
            id,username,realname,password,gender
        from
            tb_user
        where
            id = #{id}
    </select>
    <select id="selectUserByNameAndPassword" resultType="com.vcpf.jee202405110414.entity.User">
        select
            id,username,realname,password,gender
        from
            tb_user
        where
            username = #{username} and password=#{password}
    </select>
</mapper>